{
  "name": "frontend_service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:mock": "cross-env VITE_MOCK_BACKEND=1 MOCK_BACKEND=1 SSE_BRIDGE_ORIGIN=http://127.0.0.1:8017 react-router dev",
    "build": "react-router build",
    "start": "react-router-serve build/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typegen": "react-router typegen",
    "test": "npm run typegen && vitest run",
    "test:watch": "npm run typegen && vitest",
    "e2e": "cross-env VITE_MOCK_BACKEND=1 MOCK_BACKEND=1 SSE_BRIDGE_ORIGIN=http://127.0.0.1:8017 playwright test"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-toast": "^1.2.15",
    "@react-router/node": "^7.11.0",
    "@react-router/serve": "^7.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.31",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.2",
    "motion": "^11.18.2",
    "msw": "^2.12.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.11.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@react-router/dev": "^7.11.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "cross-env": "^10.1.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
